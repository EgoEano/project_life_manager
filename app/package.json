{
    "name": "template",
    "version": "0.0.1",
    "private": true,
    "scripts": {
        "web:build:prod": "npm run cleanBuild && cross-env NO_COLOR=true NODE_ENV=production webpack --mode production --config-name client",
        "web:build:prod:inline": "npm run cleanBuild && cross-env INLINE=true NO_COLOR=true NODE_ENV=production webpack --mode production --config-name client",
        "web:build:dev": "cross-env NO_COLOR=true NODE_ENV=development webpack --mode development --config-name client",
        "web:start:dev": "cross-env NO_COLOR=true NODE_ENV=development webpack serve --config-name client --mode development",
        "mobile:android:start:dev": "cross-env NO_COLOR=true NODE_ENV=development react-native run-android",
        "mobile:ios:start:dev": "cross-env NO_COLOR=true NODE_ENV=development react-native run-ios",
        "mobile:android:build:prod": "cd android && gradlew assembleRelease",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "clean": "npm cache clean --force && rd /s /q node_modules",
        "cleanBuild": "rimraf node_modules/.cache/webpack dist build",
        "test": "jest",
        "start": "react-native start",
        "android": "react-native run-android",
        "ios": "react-native run-ios"
    },
    "dependencies": {
        "@babel/preset-react": "^7.28.5",
